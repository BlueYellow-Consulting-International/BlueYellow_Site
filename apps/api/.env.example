# NestJS API (apps/api) — copy to .env
PORT=4000

# Allowed browser origin for CORS (the Next.js dev server)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Our own PostgreSQL — the source of truth (started by `docker compose up -d`, service "db")
DATABASE_URL=postgresql://consulting:change-me-local-only@localhost:5433/consulting?schema=public

# JWT signing secret for the auth module (register/login +JwtGuard)
JWT_SECRET=change-me-local-only

# Admin bootstrap (used by `pnpm db:seed`; idempotent — updates existing row)
ADMIN_EMAIL=admin@blueyellow.test
ADMIN_PASSWORD=admin123-change-me
