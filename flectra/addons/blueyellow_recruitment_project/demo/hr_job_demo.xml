<?xml version="1.0" encoding="utf-8"?>
<flectra>
    <data noupdate="1">
        <record id="project_client_co_engagement" model="project.project">
            <field name="name">Backend help for v1 launch — contract</field>
            <field name="company_id" ref="blueyellow_client.company_client_co"/>
            <field name="partner_id" ref="blueyellow_client.partner_client_co"/>
            <field name="privacy_visibility">portal</field>
        </record>

        <record id="job_senior_python_consultant" model="hr.job">
            <field name="name">Need a Python dev for our MVP (part-time, remote OK)</field>
            <field name="company_id" ref="blueyellow_client.company_client_co"/>
            <field name="project_id" ref="project_client_co_engagement"/>
            <field name="user_id" ref="blueyellow_client.user_showcase_client_manager"/>
            <field name="is_published">True</field>
            <field name="website_description" type="html">
                <p><strong>Posted on BlueYellow</strong> — Small product team shipping v1. Need a backend dev to harden auth, write tests, and pair with our founder on 2–3 calls/week.</p>
                <p>Submit a short proposal with your rate, availability, and one relevant link.</p>
            </field>
        </record>
    </data>
</flectra>
