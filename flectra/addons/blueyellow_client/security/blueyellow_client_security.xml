<?xml version="1.0" encoding="utf-8"?>
<flectra>
    <record id="module_category_blueyellow" model="ir.module.category">
        <field name="name">BlueYellow</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_client_project" model="res.groups">
        <field name="name">Client Project Manager</field>
        <field name="category_id" ref="module_category_blueyellow"/>
        <field name="implied_ids" eval="[(6, 0, [ref('project.group_project_user')])]"/>
    </record>

    <record id="group_client" model="res.groups">
        <field name="name">Client</field>
        <field name="category_id" ref="module_category_blueyellow"/>
        <field name="implied_ids" eval="[(6, 0, [
            ref('base.group_user'),
            ref('base.group_multi_company'),
            ref('hr_recruitment.group_hr_recruitment_user'),
            ref('group_client_project'),
            ref('account.group_account_invoice'),
            ref('hr_timesheet.group_hr_timesheet_approver'),
        ])]"/>
    </record>

    <record id="res_company_client_read_rule" model="ir.rule">
        <field name="name">Client: read owned and allowed companies</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="domain_force">['|', ('blueyellow_owner_id', '=', user.id), ('id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_client'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="project_project_client_company_rule" model="ir.rule">
        <field name="name">Client: projects limited to allowed companies</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="domain_force">[('company_id', 'in', company_ids), ('company_id', '!=', False)]</field>
        <field name="groups" eval="[(4, ref('group_client'))]"/>
    </record>

    <record id="project_task_client_company_rule" model="ir.rule">
        <field name="name">Client: tasks limited to allowed companies</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">[('company_id', 'in', company_ids), ('company_id', '!=', False)]</field>
        <field name="groups" eval="[(4, ref('group_client'))]"/>
    </record>

    <record id="project_project_client_project_rule" model="ir.rule">
        <field name="name">Client Project Manager: projects in allowed companies</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="domain_force">[('company_id', 'in', company_ids), ('company_id', '!=', False)]</field>
        <field name="groups" eval="[(4, ref('group_client_project'))]"/>
    </record>

    <record id="project_task_client_project_rule" model="ir.rule">
        <field name="name">Client Project Manager: tasks in allowed companies</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">[('company_id', 'in', company_ids), ('company_id', '!=', False)]</field>
        <field name="groups" eval="[(4, ref('group_client_project'))]"/>
    </record>
</flectra>
