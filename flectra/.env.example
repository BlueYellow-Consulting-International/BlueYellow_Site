POSTGRES_USER=db
POSTGRES_PASSWORD=flectra
HOST=db
USER=db
PASSWORD=flectra

# Runtime user for bind-mounted files. Set these to the output of:
#   id -u
#   id -g
# The container entrypoint creates this user at startup; no Dockerfile edit required.
HOST_UID=1030
HOST_GID=100

# Fresh database bootstrap. Keep website and theme_blueyellow at the end of the list.
FLECTRA_DB=flectra
FLECTRA_AUTO_INIT=1
# Sales/CRM, accounting, project, HR, marketing, website apps, then theme
FLECTRA_INIT_MODULES=crm,sale_management,account_accountant,project,project_todo,calendar,contacts,hr,hr_attendance,hr_contract,hr_expense,hr_recruitment,hr_skills,mass_mailing,survey,website_event,website_hr_recruitment,website_slides,website_sale,website,theme_blueyellow
FLECTRA_DEFAULT_THEME=theme_blueyellow
