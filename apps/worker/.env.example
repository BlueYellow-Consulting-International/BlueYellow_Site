# Outbox worker (apps/worker) — copy to .env
DATABASE_URL=postgresql://consulting:change-me-local-only@localhost:5433/consulting?schema=public

# false = NoopFlectraAdapter (no Flectra needed; logs and fake ids)
# true  = RealFlectraAdapter (requires the four FLECTRA_* values below)
FLECTRA_ENABLED=false
FLECTRA_URL=http://localhost:7073
FLECTRA_DB=flectra
FLECTRA_USER=admin
FLECTRA_API_KEY=generate-in-flectra-user-preferences

# Outbox polling
POLL_INTERVAL_MS=5000
BATCH_SIZE=10
MAX_ATTEMPTS=5
