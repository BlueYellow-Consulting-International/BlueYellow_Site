<?xml version="1.0" encoding="utf-8"?>
<flectra>
    <record id="client_organization_wizard_view_form" model="ir.ui.view">
        <field name="name">client.organization.wizard.form</field>
        <field name="model">client.organization.wizard</field>
        <field name="arch" type="xml">
            <form string="New Organization">
                <group>
                    <field name="name" placeholder="e.g. Client Co."/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="country_id"/>
                    <field name="parent_id" groups="base.group_no_one"/>
                </group>
                <footer>
                    <button name="action_create_organization"
                            string="Create"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="client_organization_wizard_action" model="ir.actions.act_window">
        <field name="name">New Organization</field>
        <field name="res_model">client.organization.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</flectra>
