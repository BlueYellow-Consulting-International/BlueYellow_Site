# Next.js (apps/web) — copy to .env
# The browser talks ONLY to this app's /api route handlers (BFF). Handlers
# forward to the NestJS API server-side using API_URL (never public).
API_URL=http://localhost:4000

# Flip to true once HTTPS terminates in front (e.g. Nginx Proxy Manager)
COOKIE_SECURE=false
