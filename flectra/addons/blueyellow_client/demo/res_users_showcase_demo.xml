<?xml version="1.0" encoding="utf-8"?>
<flectra>
    <data noupdate="1">
        <!-- Platform management (native groups; no BlueYellow Client/Consultant) -->
        <record id="partner_platform_ops" model="res.partner">
            <field name="name">Platform Ops</field>
            <field name="email">ops@blueyellow.demo</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <record id="user_platform_ops" model="res.users" context="{'no_reset_password': True}">
            <field name="partner_id" ref="partner_platform_ops"/>
            <field name="login">ops@blueyellow.demo</field>
            <field name="password">demo</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="company_ids" eval="[(6, 0, [ref('base.main_company'), ref('company_client_co'), ref('company_northstar')])]"/>
            <field name="groups_id" eval="[Command.set([
                ref('base.group_user'),
                ref('base.group_system'),
                ref('base.group_multi_company'),
                ref('account.group_account_manager'),
                ref('hr_recruitment.group_hr_recruitment_manager'),
                ref('hr_timesheet.group_timesheet_manager'),
                ref('project.group_project_manager'),
            ])]"/>
        </record>

        <record id="partner_platform_billing" model="res.partner">
            <field name="name">Platform Billing</field>
            <field name="email">billing@blueyellow.demo</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <record id="user_platform_billing" model="res.users" context="{'no_reset_password': True}">
            <field name="partner_id" ref="partner_platform_billing"/>
            <field name="login">billing@blueyellow.demo</field>
            <field name="password">demo</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="company_ids" eval="[(6, 0, [ref('base.main_company'), ref('company_client_co'), ref('company_northstar')])]"/>
            <field name="groups_id" eval="[Command.set([
                ref('base.group_user'),
                ref('base.group_multi_company'),
                ref('account.group_account_manager'),
                ref('project.group_project_manager'),
                ref('hr_timesheet.group_timesheet_manager'),
            ])]"/>
        </record>

        <!-- Client Co. showcase seats -->
        <record id="partner_showcase_client_manager" model="res.partner">
            <field name="name">Casey Client Manager</field>
            <field name="email">client.manager@clientco.demo</field>
            <field name="company_id" ref="company_client_co"/>
        </record>

        <record id="user_showcase_client_manager" model="res.users" context="{'no_reset_password': True}">
            <field name="partner_id" ref="partner_showcase_client_manager"/>
            <field name="login">client.manager@clientco.demo</field>
            <field name="password">demo</field>
            <field name="company_id" ref="company_client_co"/>
            <field name="company_ids" eval="[(6, 0, [ref('company_client_co')])]"/>
            <field name="groups_id" eval="[Command.set([ref('blueyellow_client.group_client')])]"/>
        </record>

        <function model="res.company" name="write">
            <value eval="[ref('company_client_co')]"/>
            <value eval="{'blueyellow_owner_id': ref('user_showcase_client_manager')}"/>
        </function>

        <record id="partner_showcase_client_staff" model="res.partner">
            <field name="name">Sam Client Staff</field>
            <field name="email">client.staff@clientco.demo</field>
            <field name="company_id" ref="company_client_co"/>
        </record>

        <record id="user_showcase_client_staff" model="res.users" context="{'no_reset_password': True}">
            <field name="partner_id" ref="partner_showcase_client_staff"/>
            <field name="login">client.staff@clientco.demo</field>
            <field name="password">demo</field>
            <field name="company_id" ref="company_client_co"/>
            <field name="company_ids" eval="[(6, 0, [ref('company_client_co')])]"/>
            <field name="groups_id" eval="[Command.set([ref('blueyellow_client.group_client')])]"/>
        </record>

        <!-- Second client org: Northstar Retail -->
        <record id="partner_northstar_manager" model="res.partner">
            <field name="name">Nina Northstar Manager</field>
            <field name="email">client.manager@northstar.demo</field>
            <field name="company_id" ref="company_northstar"/>
        </record>

        <record id="user_northstar_manager" model="res.users" context="{'no_reset_password': True}">
            <field name="partner_id" ref="partner_northstar_manager"/>
            <field name="login">client.manager@northstar.demo</field>
            <field name="password">demo</field>
            <field name="company_id" ref="company_northstar"/>
            <field name="company_ids" eval="[(6, 0, [ref('company_northstar')])]"/>
            <field name="groups_id" eval="[Command.set([ref('blueyellow_client.group_client')])]"/>
        </record>

        <function model="res.company" name="write">
            <value eval="[ref('company_northstar')]"/>
            <value eval="{'blueyellow_owner_id': ref('user_northstar_manager')}"/>
        </function>
    </data>
</flectra>
