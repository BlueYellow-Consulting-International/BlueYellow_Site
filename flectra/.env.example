POSTGRES_USER=db
POSTGRES_PASSWORD=flectra
HOST=db

# Runtime user for bind-mounted files. Set these to the output of:
#   id -u
#   id -g
# The container entrypoint creates this user at startup; no Dockerfile edit required.
HOST_UID=1030
HOST_GID=100

# Fresh database bootstrap. Keep website and theme_blueyellow at the end of the list.
FLECTRA_DB=flectra
FLECTRA_AUTO_INIT=1
# Sales/CRM, accounting, project, HR, marketing, website apps, then theme
FLECTRA_INIT_MODULES=crm,sale_management,account_accountant,project,project_todo,calendar,contacts,hr,hr_attendance,hr_contract,hr_expense,hr_recruitment,hr_skills,hr_timesheet,sale_project,sale_timesheet,mass_mailing,survey,website_event,website_hr_recruitment,website_slides,website_sale,website_partner,website_crm_partner_assign,account_payment,payment,blueyellow_client,blueyellow_consultant,blueyellow_recruitment_project,website,theme_blueyellow
# Optional existing-database sync. Leave blank for normal starts; set before a
# deploy when these modules should be installed/upgraded automatically.
# Example: blueyellow_client,blueyellow_consultant,blueyellow_recruitment_project,theme_blueyellow
FLECTRA_UPGRADE_MODULES=
FLECTRA_DEFAULT_THEME=theme_blueyellow

# Safety toggles. Defaults are production-safe: no automatic DB drop, no
# repeated theme override, no repeated homepage rewrite, no asset purge unless
# a fresh bootstrap/theme/module upgrade ran.
FLECTRA_ALLOW_AUTO_DB_RESET=0
FLECTRA_FORCE_DEFAULT_THEME=0
FLECTRA_ENSURE_HOMEPAGE=0
FLECTRA_CLEAR_ASSETS_ON_BOOT=0

# Set to 1 when Flectra runs behind a trusted reverse proxy (nginx, Traefik, etc.).
# Enables Werkzeug X-Forwarded-* header support via flectra-bin --proxy-mode.
# Leave at 0 for direct access on localhost:7073.
FLECTRA_PROXY_MODE=0

# Public URL when using a reverse proxy (required for website editor over HTTPS).
# Example: https://flectra.example.com
# FLECTRA_WEB_BASE_URL=
