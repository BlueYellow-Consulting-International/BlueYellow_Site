# ─── Docker Compose credentials (local development only) ─────────────────────
# Copy this file to .env — docker compose reads it automatically.

# Our PostgreSQL (used by apps/api and apps/worker via DATABASE_URL)
POSTGRES_USER=consulting
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=consulting
# Host port for our PostgreSQL — override if 5432 is already taken on this machine
DB_HOST_PORT=5433

# Flectra CRM stack uses flectra/.env (see flectra/.env.example).

# App-level environment files live next to each app — copy those too:
#   apps/api/.env.example  →  apps/api/.env
#   apps/worker/.env.example  →  apps/worker/.env
#   apps/web/.env.example  →  apps/web/.env

# App secrets consumed by the api container (see docker-compose.yml)
JWT_SECRET=change-me-local-only
ADMIN_EMAIL=admin@blueyellow.test
ADMIN_PASSWORD=admin123-change-me
# Public API URL baked into the web client bundle
NEXT_PUBLIC_API_URL=http://localhost:4000
