<?xml version="1.0" encoding="utf-8"?>
<flectra>
    <data noupdate="1">
        <record id="partner_consultant" model="res.partner">
            <field name="name">Alex Consultant</field>
            <field name="email">consultant@blueyellow.example.com</field>
            <field name="phone">+1 555-010-3000</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="is_published">True</field>
        </record>

        <record id="user_consultant" model="res.users" context="{'no_reset_password': True}">
            <field name="partner_id" ref="partner_consultant"/>
            <field name="login">consultant@blueyellow.example.com</field>
            <field name="password">demo</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="groups_id" eval="[Command.set([ref('blueyellow_consultant.group_consultant')])]"/>
        </record>
    </data>
</flectra>
