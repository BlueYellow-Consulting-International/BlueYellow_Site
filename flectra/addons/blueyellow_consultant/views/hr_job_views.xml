<?xml version="1.0" encoding="utf-8"?>
<flectra>
    <record id="hr_job_view_form_consultant_pool" model="ir.ui.view">
        <field name="name">hr.job.form.consultant.pool</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr_recruitment.hr_job_survey"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_blueyellow_open_job_website"
                            type="object"
                            string="Submit proposal"
                            class="btn-primary"
                            groups="blueyellow_consultant.group_consultant"/>
                </header>
            </xpath>
        </field>
    </record>

    <record id="hr_job_view_form_consultant_gig" model="ir.ui.view">
        <field name="name">hr.job.form.consultant.gig</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr_recruitment.hr_job_survey"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='recruitment_page']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='job_description_page']" position="attributes">
                <attribute name="string">Gig details</attribute>
            </xpath>
            <xpath expr="//page[@name='job_description_page']/field[@name='description']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//div[hasclass('oe_chatter')]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@class='oe_title']" position="after">
                <group>
                    <field name="company_id" readonly="1" string="Posted by"/>
                </group>
            </xpath>
            <xpath expr="//h1/field[@name='name']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_blueyellow_open_job_website"
                            type="object"
                            string="Submit proposal"
                            class="btn-primary"/>
                </header>
            </xpath>
        </field>
    </record>
</flectra>
